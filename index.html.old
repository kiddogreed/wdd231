<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WDD 231 - Course Home Page</title>
    <meta name="description" content="Course home page for WDD 231 Web Frontend Development I featuring course work, certificate progress, and developer info.">
    <meta name="author" content="Your Name">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
    
    <!-- CSS Stylesheets -->
    <link rel="stylesheet" href="styles/normalize.css">
    <link rel="stylesheet" href="styles/small.css">
    <link rel="stylesheet" href="styles/larger.css">
    
    <!-- JavaScript Files -->
    <script src="scripts/navigation.js" defer></script>
    <script src="scripts/date.js" defer></script>
    <script src="scripts/course.js" defer></script>
</head>
<body>
    <header>
        <div class="logo-container">
            <img src="images/logo.svg" alt="Site Logo" width="40" height="40">
            <span>Your Name</span>
        </div>
        <button id="hamburger" aria-label="Toggle Menu">&#9776;</button>
    </header>

    <nav id="primary-nav">
        <ul>
            <li><a href="#" class="active">Home</a></li>
            <li><a href="chamber/index.html">Chamber Project</a></li>
            <li><a href="final/index.html">Final Project</a></li>
        </ul>
    </nav>

    <main>
        <h1>Home</h1>
        
        <div class="grid-container">
            <section class="card">
                <h2>About Me</h2>
                <p>Welcome to my home page. I am studying Web and Computer Programming. I enjoy software design, web development, and problem-solving.</p>
            </section>

            <section class="card">
                <h2>Student Photo</h2>
                <img src="images/student-photo.webp" alt="Student Portrait" width="300" height="300" loading="lazy">
            </section>
        </div>

        <section class="card courses-section">
            <h2>Web Certificate Courses</h2>
            <div class="filter-buttons">
                <button id="all-btn">All</button>
                <button id="cse-btn">CSE</button>
                <button id="wdd-btn">WDD</button>
            </div>
            
            <div id="courses-container" class="courses-grid">
                <!-- Dynamically populated via course.js -->
            </div>
            
            <p id="total-credits">The total credits for courses listed above is <span>0</span></p>
        </section>
    </main>

    <footer>
        <div class="social-links">
            <a href="https://github.com" target="_blank" rel="noopener"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/github.svg" alt="GitHub Logo" width="24" height="24"></a>
            <a href="https://linkedin.com" target="_blank" rel="noopener"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/linkedin.svg" alt="LinkedIn Logo" width="24" height="24"></a>
            <a href="https://x.com" target="_blank" rel="noopener"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/x.svg" alt="X Logo" width="24" height="24"></a>
        </div>
        <p>&copy; <span id="currentyear"></span> • Your Name • State/Country</p>
        <p id="lastModified"></p>
    </footer>
</body>
</html>