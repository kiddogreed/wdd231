@media (min-width: 600px) {
    #hamburger {
        display: none;
    }

    nav {
        display: block !important;
    }

    nav ul {
        display: flex;
        justify-content: space-around;
    }

    .grid-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .courses-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}